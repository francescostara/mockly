{
 "spec": {
  "meta": {
   "title": "Product, learning and community",
   "subtitle": "Do new learners stay, which topics drive each language, and which community feature keeps them · {y} vs {py}",
   "brand": {
    "name": "Language App",
    "tagline": "Poland · Ukraine · Israel · Turkey"
   },
   "locale": "en-US",
   "currency": "$",
   "months": [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec"
   ],
   "strings": {
    "fullYear": "Full year",
    "all": "All",
    "allM": "All",
    "compare": "Compare",
    "qtr": "Qtr",
    "month": "Month",
    "varShort": "Var",
    "pyShort": "PY",
    "cyShort": "CY",
    "prevShort": "Prev.",
    "curShort": "Cur.",
    "reset": "Reset filters",
    "period": "Period",
    "conv": "conv.",
    "updatedLabel": "Last updated",
    "others": "Others",
    "target": "target",
    "sopra": "above",
    "sotto": "below",
    "year": "Year",
    "qtrLong": "Quarter",
    "monthLong": "Month",
    "spanLong": "How many years",
    "noPrev": "no comparable previous period",
    "trajectory": "monthly trajectory"
   },
   "updated": "Updated 2 Sep 2026",
   "source": "App events · lesson & quiz logs · store subscriptions · community features (games, chat, voice, 1:1 exchange)",
   "watermark": "Demo mockup · synthetic data · not real user activity"
  },
  "aesthetic": "agency-modern",
  "skin": {
   "shell": "top",
   "palette": "jewel-desaturati",
   "tipografia": "grottesco",
   "densita": "medio",
   "banda": "box"
  },
  "archetype": "scorecard",
  "grid": {
   "contentWidth": 1248,
   "gutter": 12,
   "columns": 4
  },
  "model": {
   "sums": [
    "lessons",
    "attempts",
    "errBase",
    "mistakes",
    "mau",
    "dau",
    "newUsers",
    "activated",
    "retD1",
    "retD7",
    "ret30",
    "trials",
    "paidNew",
    "subs",
    "revenue",
    "cancels",
    "chatters",
    "messages",
    "voiceUsers",
    "voiceMin",
    "gameUsers",
    "games",
    "xchUsers",
    "corrections",
    "newGame",
    "gameRet30",
    "newChat",
    "chatRet30",
    "newVoice",
    "voiceRet30",
    "newXch",
    "xchRet30",
    "newNone",
    "noneRet30"
   ],
   "measures": [
    {
     "id": "mauLast",
     "label": "MAU",
     "agg": "last",
     "field": "mau",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "dauLast",
     "label": "DAU",
     "agg": "last",
     "field": "dau",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "stickiness",
     "label": "Stickiness (DAU/MAU)",
     "agg": "ratio",
     "num": "dau",
     "den": "mau",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "newUsers",
     "label": "New users",
     "agg": "sum",
     "field": "newUsers",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "activation",
     "label": "Activation rate",
     "agg": "ratio",
     "num": "activated",
     "den": "newUsers",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "d1",
     "label": "D1 retention",
     "agg": "ratio",
     "num": "retD1",
     "den": "newUsers",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "d7",
     "label": "D7 retention",
     "agg": "ratio",
     "num": "retD7",
     "den": "newUsers",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "d30",
     "label": "D30 retention",
     "agg": "ratio",
     "num": "ret30",
     "den": "newUsers",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "trialToPaid",
     "label": "Trial-to-paid",
     "agg": "ratio",
     "num": "paidNew",
     "den": "trials",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "paidConv",
     "label": "Paid conversion (of MAU)",
     "agg": "ratio",
     "num": "subs",
     "den": "mau",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "subsLast",
     "label": "Paying subscribers",
     "agg": "last",
     "field": "subs",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "revenue",
     "label": "Subscription revenue",
     "agg": "sum",
     "field": "revenue",
     "unit": "money",
     "format": "eur"
    },
    {
     "id": "arppu",
     "label": "ARPPU / month",
     "agg": "ratio",
     "num": "revenue",
     "den": "subs",
     "unit": "money",
     "format": "eurF"
    },
    {
     "id": "churn",
     "label": "Subscriber churn (monthly)",
     "agg": "ratio",
     "num": "cancels",
     "den": "subs",
     "unit": "pct",
     "format": "pc",
     "inv": true
    },
    {
     "id": "lessons",
     "label": "Lessons completed",
     "agg": "sum",
     "field": "lessons",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "lessonsPerMau",
     "label": "Lessons per MAU / month",
     "agg": "ratio",
     "num": "lessons",
     "den": "mau",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "mistakeRate",
     "label": "Mistake rate",
     "agg": "ratio",
     "num": "mistakes",
     "den": "attempts",
     "unit": "pct",
     "format": "pc",
     "inv": true
    },
    {
     "id": "msgsPerMember",
     "label": "Messages per member / month",
     "agg": "ratio",
     "num": "messages",
     "den": "chatters",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "voiceMinPerUser",
     "label": "Voice minutes per voice user / month",
     "agg": "ratio",
     "num": "voiceMin",
     "den": "voiceUsers",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "gameReach",
     "label": "Games · % of MAU",
     "agg": "ratio",
     "num": "gameUsers",
     "den": "mau",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "chatReach",
     "label": "Chat rooms · % of MAU",
     "agg": "ratio",
     "num": "chatters",
     "den": "mau",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "voiceReach",
     "label": "Voice rooms · % of MAU",
     "agg": "ratio",
     "num": "voiceUsers",
     "den": "mau",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "xchReach",
     "label": "1:1 exchange · % of MAU",
     "agg": "ratio",
     "num": "xchUsers",
     "den": "mau",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "gamesPerPlayer",
     "label": "Games per player / month",
     "agg": "ratio",
     "num": "games",
     "den": "gameUsers",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "corrPerPair",
     "label": "Corrections per exchange learner / month",
     "agg": "ratio",
     "num": "corrections",
     "den": "xchUsers",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "gameD30",
     "label": "D30 · played games",
     "agg": "ratio",
     "num": "gameRet30",
     "den": "newGame",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "chatD30",
     "label": "D30 · joined chat rooms",
     "agg": "ratio",
     "num": "chatRet30",
     "den": "newChat",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "voiceD30",
     "label": "D30 · joined voice rooms",
     "agg": "ratio",
     "num": "voiceRet30",
     "den": "newVoice",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "xchD30",
     "label": "D30 · found a 1:1 partner",
     "agg": "ratio",
     "num": "xchRet30",
     "den": "newXch",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "noneD30",
     "label": "D30 · used no community feature",
     "agg": "ratio",
     "num": "noneRet30",
     "den": "newNone",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "xchLift",
     "label": "1:1 exchange lift",
     "agg": "diff",
     "a": "xchD30",
     "b": "noneD30",
     "unit": "pp",
     "format": "pp"
    },
    {
     "id": "gameLift",
     "label": "Games lift",
     "agg": "diff",
     "a": "gameD30",
     "b": "noneD30",
     "unit": "pp",
     "format": "pp"
    }
   ]
  },
  "filters": {
   "date": {
    "levels": [
     "year",
     "quarter",
     "month"
    ],
    "default": {
     "y": 2025,
     "q": null,
     "m": null
    }
   },
   "dims": [
    {
     "id": "language",
