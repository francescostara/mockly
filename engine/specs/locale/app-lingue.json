{
 "spec": {
  "meta": {
   "title": "Product, learning and community",
   "subtitle": "Do new learners stay, what do they find hard, and does the community keep them · {y} vs {py}",
   "brand": {
    "name": "Language App",
    "tagline": "Poland · Ukraine · Israel · Turkey"
   },
   "locale": "en-US",
   "currency": "$",
   "months": [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec"
   ],
   "strings": {
    "fullYear": "Full year",
    "all": "All",
    "allM": "All",
    "compare": "Compare",
    "qtr": "Qtr",
    "month": "Month",
    "varShort": "Var",
    "pyShort": "PY",
    "cyShort": "CY",
    "prevShort": "Prev.",
    "curShort": "Cur.",
    "reset": "Reset filters",
    "period": "Period",
    "conv": "conv."
   },
   "updated": "Updated 2 Sep 2026",
   "source": "App events · lesson & quiz logs · store subscriptions · community rooms",
   "watermark": "Demo mockup · synthetic data · not real user activity"
  },
  "aesthetic": "agency-modern",
  "skin": {
   "shell": "top",
   "palette": "jewel-desaturati",
   "tipografia": "grottesco",
   "densita": "medio",
   "banda": "box"
  },
  "archetype": "scorecard",
  "grid": {
   "contentWidth": 1248,
   "gutter": 12,
   "columns": 4
  },
  "model": {
   "sums": [
    "lessons",
    "attempts",
    "errBase",
    "mistakes",
    "mau",
    "dau",
    "newUsers",
    "activated",
    "retD1",
    "retD7",
    "newComm",
    "commRet30",
    "nonComm",
    "nonRet30",
    "ret30",
    "trials",
    "paidNew",
    "subs",
    "revenue",
    "cancels",
    "chatters",
    "messages",
    "voiceUsers",
    "voiceMin"
   ],
   "measures": [
    {
     "id": "mauLast",
     "label": "MAU",
     "agg": "last",
     "field": "mau",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "dauLast",
     "label": "DAU",
     "agg": "last",
     "field": "dau",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "stickiness",
     "label": "Stickiness (DAU/MAU)",
     "agg": "ratio",
     "num": "dau",
     "den": "mau",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "newUsers",
     "label": "New users",
     "agg": "sum",
     "field": "newUsers",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "activation",
     "label": "Activation rate",
     "agg": "ratio",
     "num": "activated",
     "den": "newUsers",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "d1",
     "label": "D1 retention",
     "agg": "ratio",
     "num": "retD1",
     "den": "newUsers",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "d7",
     "label": "D7 retention",
     "agg": "ratio",
     "num": "retD7",
     "den": "newUsers",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "d30",
     "label": "D30 retention",
     "agg": "ratio",
     "num": "ret30",
     "den": "newUsers",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "trialToPaid",
     "label": "Trial-to-paid",
     "agg": "ratio",
     "num": "paidNew",
     "den": "trials",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "paidConv",
     "label": "Paid conversion (of MAU)",
     "agg": "ratio",
     "num": "subs",
     "den": "mau",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "subsLast",
     "label": "Paying subscribers",
     "agg": "last",
     "field": "subs",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "revenue",
     "label": "Subscription revenue",
     "agg": "sum",
     "field": "revenue",
     "unit": "money",
     "format": "eur"
    },
    {
     "id": "arppu",
     "label": "ARPPU / month",
     "agg": "ratio",
     "num": "revenue",
     "den": "subs",
     "unit": "money",
     "format": "eurF"
    },
    {
     "id": "churn",
     "label": "Subscriber churn (monthly)",
     "agg": "ratio",
     "num": "cancels",
     "den": "subs",
     "unit": "pct",
     "format": "pc",
     "inv": true
    },
    {
     "id": "lessons",
     "label": "Lessons completed",
     "agg": "sum",
     "field": "lessons",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "lessonsPerMau",
     "label": "Lessons per MAU / month",
     "agg": "ratio",
     "num": "lessons",
     "den": "mau",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "mistakeRate",
     "label": "Mistake rate",
     "agg": "ratio",
     "num": "mistakes",
     "den": "attempts",
     "unit": "pct",
     "format": "pc",
     "inv": true
    },
    {
     "id": "communityLast",
     "label": "Community members active",
     "agg": "last",
     "field": "chatters",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "communityReach",
     "label": "Community reach (% of MAU)",
     "agg": "ratio",
     "num": "chatters",
     "den": "mau",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "msgsPerMember",
     "label": "Messages per member / month",
     "agg": "ratio",
     "num": "messages",
     "den": "chatters",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "voiceMinPerUser",
     "label": "Voice minutes per voice user / month",
     "agg": "ratio",
     "num": "voiceMin",
     "den": "voiceUsers",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "commD30",
     "label": "D30 retention · joined community",
     "agg": "ratio",
     "num": "commRet30",
     "den": "newComm",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "nonD30",
     "label": "D30 retention · no community",
     "agg": "ratio",
     "num": "nonRet30",
     "den": "nonComm",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "commLift",
     "label": "Community retention lift",
     "agg": "diff",
     "a": "commD30",
     "b": "nonD30",
     "unit": "pp",
     "format": "pp"
    }
   ]
  },
  "filters": {
   "date": {
    "levels": [
     "year",
     "quarter",
     "month"
    ],
    "default": {
     "y": 2025,
     "q": null,
     "m": null
    }
   },
   "dims": [
    {
     "id": "language",
     "label": "Language",
     "control": "dropdown",
     "allLabel": "All languages",
     "pill": "Lang."
    }
   ]
  },
  "kpiBand": [
   {
    "id": "mau",
    "label": "MAU",
    "measure": "mauLast",
    "span": 1
   },
   {
    "id": "stickiness",
    "label": "Stickiness (DAU/MAU)",
    "measure": "stickiness",
    "span": 1
   },
   {
    "id": "d30",
    "label": "D30 retention (new users)",
    "measure": "d30",
    "span": 1
   },
   {
    "id": "paidConv",
    "label": "Paid conversion",
    "measure": "paidConv",
    "span": 1
   }
  ],
  "pages": [
   {
    "id": "product",
    "title": "Product health",
    "nav": "Product",
    "subtitle": "Russian acquires and keeps worst; Ukrainian and Polish learners stick best",
    "rows": [
     {
      "visuals": [
       {
        "type": "colline",
        "span": 2,
        "h": 176,
        "title": "New users and activation — {y} vs {py}",
        "note": "The line is the activation rate",
        "legend": [
         {
          "l": "{y}",
          "c": "var(--c2)"
         },
         {
          "l": "{py}",
          "dash": true
         }
        ],
        "bind": {
         "measure": "newUsers",
         "line": "activation"
        }
       },
       {
        "type": "hbar",
        "span": 1,
        "h": 176,
        "title": "D30 retention by language",
        "subtitle": "new users still active after 30 days",
        "bind": {
         "dim": "language",
         "measure": "d30",
         "top": 6
        }
       },
       {
        "type": "delta-card",
        "span": 1,
        "h": 176,
        "title": "Stickiness (DAU/MAU)",
        "bind": {
         "measure": "stickiness"
        }
       }
      ]
     },
     {
      "flex": true,
      "visuals": [
       {
        "type": "matrix",
        "span": 4,
        "title": "Languages — product KPIs · {period}",
        "subtitle": "right-click a row for the language detail",
        "bind": {
         "dim": "language",
         "label": "Language",
         "sort": "mauLast",
         "drill": true,
         "totalsLabel": "All languages",
         "columns": [
          {
           "measure": "mauLast",
           "label": "MAU"
          },
          {
           "measure": "stickiness",
           "label": "DAU/MAU",
           "kind": "heat",
           "scale": [
            0.2,
            0.34
           ]
          },
          {
           "measure": "activation",
           "label": "Activation"
          },
          {
           "measure": "d1",
           "label": "D1"
          },
          {
           "measure": "d7",
           "label": "D7"
          },
          {
           "measure": "d30",
           "label": "D30",
           "kind": "heat",
           "scale": [
            0.07,
            0.15
           ]
          },
          {
           "measure": "trialToPaid",
           "label": "Trial→paid"
          },
          {
           "measure": "paidConv",
           "label": "Paid conv."
          },
          {
           "measure": "arppu",
           "label": "ARPPU"
          },
          {
           "measure": "churn",
           "label": "Churn",
           "kind": "heat",
           "scale": [
            0.045,
            0.1
           ],
           "inv": true
          }
         ]
        }
       }
      ]
     }
    ]
   },
   {
    "id": "learning",
    "title": "Learning by language",
    "nav": "Learning",
    "subtitle": "Cases in Polish, Russian and Ukrainian and roots in Hebrew are where mistakes pile up",
    "rows": [
     {
      "visuals": [
       {
        "type": "heatmap",
        "span": 2,
        "h": 176,
        "title": "Mistake rate by language and category · {y}",
        "subtitle": "darker = harder; click a cell to filter the language",
        "bind": {
         "dim": "language",
         "measure": "mistakeRate",
         "by": "category",
         "scale": [
          0.08,
          0.42
         ]
        }
       },
       {
        "type": "hbar",
        "span": 2,
        "h": 176,
        "title": "Most practised topics — specific to each language",
        "subtitle": "filter a language to see only its topics",
        "bind": {
         "dim": "topic",
         "measure": "lessons",
         "detail": true,
         "top": 10,
         "parent": "language"
        }
       }
      ]
     },
     {
      "flex": true,
      "visuals": [
       {
        "type": "matrix",
        "span": 4,
        "title": "Languages — learning · {period}",
        "subtitle": "right-click a row for the language detail",
        "bind": {
         "dim": "language",
         "label": "Language",
         "sort": "lessons",
         "drill": true,
         "totalsLabel": "All languages",
         "columns": [
          {
           "measure": "lessons",
           "label": "Lessons"
          },
          {
           "measure": "lessons",
           "label": "{basis}",
           "kind": "var"
          },
          {
           "measure": "lessonsPerMau",
           "label": "Lessons / MAU"
          },
          {
           "measure": "mistakeRate",
           "label": "Mistake rate",
           "kind": "heat",
           "scale": [
            0.12,
            0.3
           ],
           "inv": true
          },
          {
           "measure": "d7",
           "label": "D7"
          },
          {
           "measure": "d30",
           "label": "D30"
          }
         ]
        }
       }
      ]
     }
    ]
   },
   {
    "id": "community",
    "title": "Community — chat and voice rooms",
    "nav": "Community",
    "subtitle": "Learners who join a room in week one are more than twice as likely to still be here at day 30",
    "rows": [
     {
      "visuals": [
       {
        "type": "scatter",
        "span": 2,
        "h": 176,
        "title": "Community reach against retention lift",
        "subtitle": "by language, bubble = MAU",
        "bind": {
         "dim": "language",
         "x": "communityReach",
         "y": "commLift",
         "size": "mauLast"
        }
       },
       {
        "type": "gauge",
        "span": 1,
        "h": 176,
        "title": "D30 retention · joined community",
        "subtitle": "goal 20% for room joiners",
        "bind": {
         "measure": "commD30",
         "target": 0.2,
         "targetLabel": "goal",
         "max": 0.4
        }
       },
       {
        "type": "delta-card",
        "span": 1,
        "h": 176,
        "title": "Community reach (% of MAU)",
        "bind": {
         "measure": "communityReach"
        }
       }
      ]
     },
     {
      "flex": true,
      "visuals": [
       {
        "type": "matrix",
        "span": 4,
        "title": "Languages — community · {period}",
        "subtitle": "right-click a row for the language detail",
        "bind": {
         "dim": "language",
         "label": "Language",
         "sort": "communityLast",
         "drill": true,
         "totalsLabel": "All languages",
         "columns": [
          {
           "measure": "communityLast",
           "label": "Members active"
          },
          {
           "measure": "communityReach",
           "label": "Reach",
           "kind": "heat",
           "scale": [
            0.1,
            0.25
           ]
          },
          {
           "measure": "msgsPerMember",
           "label": "Msgs / member"
          },
          {
           "measure": "voiceMinPerUser",
           "label": "Voice min / user"
          },
          {
           "measure": "commD30",
           "label": "D30 · community"
          },
          {
           "measure": "nonD30",
           "label": "D30 · others"
          },
          {
           "measure": "commLift",
           "label": "Lift"
          }
         ]
        }
       }
      ]
     }
    ]
   }
  ],
  "drill": {
