{
  "spec": {
    "meta": {
      "title": "Sales & Profitability",
      "subtitle": "Management overview · {y} vs {py}",
      "brand": {
        "name": "Meridian Retail",
        "tagline": "Management report"
      },
      "locale": "en-US",
      "currency": "$",
      "months": [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec"
      ],
      "updated": "Data as of Dec 31, 2025",
      "source": "Source: POS, ERP and sales targets",
      "watermark": "Demo mockup · synthetic data"
    },
    "aesthetic": "corporate-sober",
    "skin": {
      "shell": "rail",
      "palette": "navy-corporate",
      "tipografia": "neutro-ui",
      "densita": "medio",
      "banda": "blocco"
    },
    "archetype": "scorecard",
    "grid": {
      "contentWidth": 1044,
      "gutter": 12,
      "columns": 5
    },
    "model": {
      "sums": [
        "rev",
        "cogs",
        "disc",
        "promo",
        "cdisc",
        "mdn",
        "profit",
        "orders",
        "tgt"
      ],
      "measures": [
        {
          "id": "rev",
          "label": "Revenue",
          "agg": "sum",
          "field": "rev",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "profit",
          "label": "Gross profit",
          "agg": "sum",
          "field": "profit",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "gm",
          "label": "Gross margin",
          "agg": "ratio",
          "num": "profit",
          "den": "rev",
          "unit": "pct",
          "format": "pc"
        },
        {
          "id": "orders",
          "label": "Orders",
          "agg": "sum",
          "field": "orders",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "aov",
          "label": "Avg order value",
          "agg": "ratio",
          "num": "rev",
          "den": "orders",
          "unit": "money",
          "format": "eurF"
        },
        {
          "id": "mdn",
          "label": "Markdowns",
          "agg": "sum",
          "field": "mdn",
          "unit": "money",
          "format": "eur",
          "inv": true
        },
        {
          "id": "mdr",
          "label": "Markdown rate",
          "agg": "ratio",
          "num": "mdn",
          "den": "rev",
          "unit": "pct",
          "format": "pc",
          "inv": true
        },
        {
          "id": "tgt",
          "label": "Sales target",
          "agg": "sum",
          "field": "tgt",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "att",
          "label": "Target attainment",
          "agg": "ratio",
          "num": "rev",
          "den": "tgt",
          "unit": "pct",
          "format": "pc"
        }
      ]
    },
    "filters": {
      "date": {
        "levels": [
          "year",
          "quarter",
          "month"
        ],
        "default": {
          "y": 2025,
          "q": null,
          "m": null
        }
      },
      "dims": [
        {
          "id": "region",
          "label": "Region",
          "control": "list",
          "allLabel": "All regions",
          "pill": "Region"
        },
        {
          "id": "segment",
          "label": "Segment",
          "control": "list",
          "allLabel": "All segments",
          "pill": "Segment"
        },
        {
          "id": "cat",
          "label": "Category",
          "control": "dropdown",
          "allLabel": "All categories",
          "pill": "Category"
        }
      ]
    },
    "kpiBand": [
      {
        "id": "rev",
        "label": "Revenue",
        "measure": "rev",
        "span": 1
      },
      {
        "id": "profit",
        "label": "Gross profit",
        "measure": "profit",
        "span": 1
      },
      {
        "id": "gm",
        "label": "Gross margin",
        "measure": "gm",
        "span": 1
      },
      {
        "id": "orders",
        "label": "Orders",
        "measure": "orders",
        "span": 1
      },
      {
        "id": "aov",
        "label": "Avg order value",
        "measure": "aov",
        "span": 1
      }
    ],
    "pages": [
      {
        "id": "overview",
        "title": "Business performance",
        "subtitle": "Revenue grows, margin slips: Furniture shrinks, markdowns rise in the West, Corporate deals cost margin",
        "nav": "Overview",
        "rows": [
          {
            "visuals": [
              {
                "id": "trends",
                "span": 4,
                "h": 196,
                "motivo": "pagina-sprecata",
                "viste": [
                  {
                    "type": "colline",
                    "span": 4,
                    "h": 196,
                    "title": "Monthly revenue vs {py}, with gross margin",
                    "bind": {
                      "measure": "rev",
                      "line": "gm"
                    },
                    "etichetta": "Revenue"
                  },
                  {
                    "type": "trend",
                    "span": 4,
                    "title": "Monthly gross profit, {y} vs {py}",
                    "bind": {
                      "measure": "profit"
                    },
                    "h": 196,
                    "etichetta": "Profit"
                  }
                ]
              },
              {
                "type": "gauge",
                "span": 1,
                "title": "Sales vs target — {period}",
                "bind": {
                  "measure": "att",
                  "target": 1,
                  "targetLabel": "Target"
                },
                "h": 196
              }
            ]
          },
          {
            "flex": true,
            "visuals": [
              {
                "type": "matrix",
                "span": 5,
                "title": "Categories — which ones drive the result · {period}",
                "bind": {
                  "dim": "cat",
                  "label": "Category",
                  "sort": "rev",
                  "drill": true,
                  "totalsLabel": "Total company",
                  "columns": [
                    {
                      "measure": "rev",
                      "label": "Revenue"
                    },
                    {
                      "measure": "rev",
                      "label": "{basis}",
                      "kind": "var"
                    },
                    {
                      "measure": "profit",
                      "label": "Gross profit"
                    },
                    {
                      "measure": "profit",
                      "label": "{basis}",
                      "kind": "var"
                    },
                    {
                      "measure": "gm",
                      "label": "Gross margin",
                      "kind": "heat",
                      "scale": [
                        0.2,
                        0.55
                      ]
                    },
                    {
                      "measure": "gm",
                      "label": "Margin {basis}",
                      "kind": "var"
                    },
                    {
                      "measure": "orders",
                      "label": "Orders"
                    },
                    {
                      "measure": "aov",
                      "label": "AOV"
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "id": "regions",
        "title": "Regions, segments and products",
        "subtitle": "The West grows fastest and beats its target while its margin falls: markdowns are buying the growth",
        "nav": "Regions & products",
        "rows": [
          {
            "visuals": [
              {
                "type": "heatmap",
                "span": 3,
                "h": 176,
                "title": "Gross margin by region and customer segment · {period}",
                "subtitle": "darker = higher margin; click a cell to filter the region",
                "bind": {
                  "dim": "region",
                  "measure": "gm",
                  "by": "segment"
                }
              },
              {
                "id": "products",
                "span": 2,
                "h": 176,
                "motivo": "due-lenti",
                "viste": [
                  {
                    "type": "hbar",
                    "etichetta": "Best",
                    "span": 2,
                    "title": "Top products by gross profit",
                    "bind": {
                      "dim": "prod",
                      "measure": "profit",
                      "detail": true,
                      "parent": "cat",
                      "top": 6,
                      "subMeasure": "gm",
                      "subUnit": " margin"
                    }
                  },
                  {
                    "type": "hbar",
                    "etichetta": "Need attention",
                    "span": 2,
                    "title": "Products with the lowest gross profit",
                    "bind": {
                      "dim": "prod",
                      "measure": "profit",
                      "detail": true,
                      "parent": "cat",
                      "top": 6,
                      "order": "asc",
                      "subMeasure": "gm",
                      "subUnit": " margin"
                    }
                  }
                ]
              }
            ]
          },
          {
            "flex": true,
            "visuals": [
              {
                "type": "matrix",
                "span": 5,
                "title": "Regions — growth, margin and target · {period}",
                "bind": {
                  "dim": "region",
                  "label": "Region",
                  "sort": "rev",
                  "drill": false,
                  "totalsLabel": "Total company",
                  "columns": [
                    {
                      "measure": "rev",
                      "label": "Revenue"
                    },
                    {
                      "measure": "rev",
                      "label": "{basis}",
                      "kind": "var"
                    },
                    {
                      "measure": "profit",
                      "label": "Gross profit"
                    },
                    {
                      "measure": "gm",
                      "label": "Gross margin",
                      "kind": "heat",
                      "scale": [
                        0.3,
                        0.38
                      ]
                    },
                    {
                      "measure": "gm",
                      "label": "Margin {basis}",
                      "kind": "var"
                    },
                    {
                      "measure": "mdr",
                      "label": "Markdown rate",
                      "inv": true
                    },
                    {
                      "measure": "att",
                      "label": "vs target",
                      "kind": "heat",
                      "scale": [
                        0.9,
                        1.05
                      ]
                    },
                    {
                      "measure": "orders",
                      "label": "Orders"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
    "drill": {
      "dim": "cat",
      "page": {
        "id": "__drill__",
        "title": "{drill}",
        "drillHeader": "{period} · {basis}",
        "backLabel": "Back to all categories",
        "subtitle": "Products and monthly trend of the category",
        "rows": [
          {
            "flex": true,
            "visuals": [
              {
                "type": "hbar",
                "span": 3,
                "h": 300,
                "title": "Products by revenue, with gross margin",
                "bind": {
                  "dim": "prod",
                  "measure": "rev",
                  "detail": true,
                  "parent": "cat",
                  "top": 8,
                  "subMeasure": "gm",
                  "subUnit": " margin"
                }
              },
              {
                "type": "colline",
                "span": 2,
                "h": 300,
                "title": "Monthly revenue vs {py}, with gross margin",
                "bind": {
                  "measure": "rev",
                  "line": "gm"
                }
              }
            ]
          }
        ]
      }
    }
  },
