{
  "spec": {
    "meta": {
      "title": "Sales Performance",
      "subtitle": "Revenue, trends and growth · {y} vs {py}",
      "brand": {
        "name": "Trailhead Sports",
        "tagline": "Sales report"
      },
      "locale": "en-US",
      "currency": "$",
      "months": [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec"
      ],
      "updated": "Data as of Dec 31, 2025",
      "source": "Source: POS and e-commerce orders",
      "watermark": "Demo mockup · synthetic data"
    },
    "aesthetic": "corporate-sober",
    "skin": {
      "shell": "top",
      "palette": "salvia",
      "tipografia": "umanista",
      "densita": "arioso",
      "banda": "box"
    },
    "archetype": "scorecard",
    "grid": {
      "contentWidth": 1248,
      "gutter": 16,
      "columns": 4
    },
    "model": {
      "sums": [
        "rev",
        "orders",
        "units"
      ],
      "measures": [
        {
          "id": "rev",
          "label": "Revenue",
          "agg": "sum",
          "field": "rev",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "orders",
          "label": "Orders",
          "agg": "sum",
          "field": "orders",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "units",
          "label": "Units sold",
          "agg": "sum",
          "field": "units",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "aov",
          "label": "Avg order value",
          "agg": "ratio",
          "num": "rev",
          "den": "orders",
          "unit": "money",
          "format": "eurF"
        },
        {
          "id": "upo",
          "label": "Units per order",
          "agg": "ratio",
          "num": "units",
          "den": "orders",
          "unit": "x",
          "format": "x"
        }
      ]
    },
    "filters": {
      "date": {
        "levels": [
          "year",
          "quarter",
          "month"
        ],
        "default": {
          "y": 2025,
          "q": null,
          "m": null
        }
      },
      "dims": [
        {
          "id": "cat",
          "label": "Category",
          "control": "dropdown",
          "allLabel": "All categories",
          "pill": "Category"
        },
        {
          "id": "region",
          "label": "Region",
          "control": "list",
          "allLabel": "All regions",
          "pill": "Region"
        }
      ]
    },
    "kpiBand": [
      {
        "id": "rev",
        "label": "Total revenue",
        "measure": "rev",
        "span": 1
      },
      {
        "id": "orders",
        "label": "Orders",
        "measure": "orders",
        "span": 1
      },
      {
        "id": "aov",
        "label": "Avg order value",
        "measure": "aov",
        "span": 1
      },
      {
        "id": "units",
        "label": "Units sold",
        "measure": "units",
        "span": 1
      }
    ],
    "pages": [
      {
        "id": "overview",
        "title": "Sales overview",
        "subtitle": "Growth comes from the Southwest and Cycling; Fitness and the Midwest are shrinking",
        "nav": "Overview",
        "rows": [
          {
            "visuals": [
              {
                "type": "trend",
                "span": 3,
                "h": 190,
                "title": "Monthly revenue, {y} vs {py}",
                "bind": {
                  "measure": "rev"
                }
              },
              {
                "type": "delta-card",
                "span": 1,
                "h": 190,
                "title": "Revenue growth",
                "bind": {
                  "measure": "rev"
                }
              }
            ]
          },
          {
            "flex": true,
            "visuals": [
              {
                "type": "matrix",
                "span": 4,
                "title": "Sales by region · {period}",
                "bind": {
                  "dim": "region",
                  "label": "Region",
                  "sort": "rev",
                  "drill": false,
                  "totalsLabel": "Total",
                  "columns": [
                    {
                      "measure": "rev",
                      "label": "Revenue"
                    },
                    {
                      "measure": "rev",
                      "label": "{basis}",
                      "kind": "var"
                    },
                    {
                      "measure": "rev",
                      "label": "Share",
                      "kind": "share"
                    },
                    {
                      "measure": "orders",
                      "label": "Orders"
                    },
                    {
                      "measure": "orders",
                      "label": "Orders {basis}",
                      "kind": "var"
                    },
                    {
                      "measure": "aov",
                      "label": "AOV"
                    },
                    {
                      "measure": "upo",
                      "label": "Units / order"
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "id": "products",
        "title": "Categories and products",
        "subtitle": "Each category peaks in its own season: the ranking changes month by month",
        "nav": "Categories & products",
        "rows": [
          {
            "visuals": [
              {
                "type": "ribbon",
                "span": 3,
                "h": 200,
                "title": "Revenue rank by category, month by month · {y}",
                "subtitle": "a band that climbs is a category taking the lead",
                "bind": {
                  "dim": "cat",
                  "measure": "rev",
                  "by": "m"
                }
              },
              {
                "id": "products",
                "span": 1,
                "h": 200,
                "motivo": "due-lenti",
                "viste": [
                  {
                    "type": "hbar",
                    "etichetta": "Top",
                    "span": 1,
                    "title": "Top products",
                    "bind": {
                      "dim": "prod",
                      "measure": "rev",
                      "detail": true,
                      "parent": "cat",
                      "top": 6
                    }
                  },
                  {
                    "type": "hbar",
                    "etichetta": "Bottom",
                    "span": 1,
                    "title": "Weakest products",
                    "bind": {
                      "dim": "prod",
                      "measure": "rev",
                      "detail": true,
                      "parent": "cat",
                      "top": 6,
                      "order": "asc"
                    }
                  }
                ]
              }
            ]
          },
          {
            "flex": true,
            "visuals": [
              {
                "type": "matrix",
                "span": 4,
                "title": "Categories · {period}",
                "bind": {
                  "dim": "cat",
                  "label": "Category",
                  "sort": "rev",
                  "drill": true,
                  "totalsLabel": "Total",
                  "columns": [
                    {
                      "measure": "rev",
                      "label": "Revenue"
                    },
                    {
                      "measure": "rev",
                      "label": "{basis}",
                      "kind": "var"
                    },
                    {
                      "measure": "rev",
                      "label": "Share",
                      "kind": "share"
                    },
                    {
                      "measure": "units",
                      "label": "Units"
                    },
                    {
                      "measure": "aov",
                      "label": "AOV"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
    "drill": {
      "dim": "cat",
      "page": {
        "id": "__drill__",
        "title": "{drill}",
        "drillHeader": "{period} · {basis}",
        "backLabel": "Back to all categories",
        "subtitle": "Products and monthly revenue of the category",
        "rows": [
          {
            "flex": true,
            "visuals": [
              {
                "type": "hbar",
                "span": 2,
                "h": 300,
                "title": "Products by revenue",
                "bind": {
                  "dim": "prod",
                  "measure": "rev",
                  "detail": true,
                  "parent": "cat",
                  "top": 8,
                  "subMeasure": "units",
                  "subUnit": " units"
                }
              },
              {
                "type": "trend",
                "span": 2,
                "h": 300,
                "title": "Monthly revenue, {y} vs {py}",
                "bind": {
                  "measure": "rev"
                }
              }
            ]
          }
        ]
      }
    }
  },
