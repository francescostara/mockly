{
  "spec": {
    "meta": {
      "title": "Supply Chain Performance",
      "subtitle": "Service levels against target · {y} vs {py}",
      "brand": {
        "name": "NorthPeak Consumer Goods",
        "tagline": "Distribution"
      },
      "locale": "en-US",
      "currency": "$",
      "months": [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec"
      ],
      "updated": "Data as of Dec 31, 2025",
      "source": "Source: WMS and TMS",
      "watermark": "Demo mockup · synthetic data"
    },
    "aesthetic": "corporate-sober",
    "skin": {
      "shell": "rail",
      "palette": "blu-ghiaccio",
      "tipografia": "tecnico",
      "densita": "medio",
      "banda": "box"
    },
    "archetype": "operational",
    "grid": {
      "contentWidth": 1044,
      "gutter": 12,
      "columns": 5
    },
    "model": {
      "sums": [
        "orders",
        "cases",
        "shipped",
        "ontime",
        "otif",
        "freight"
      ],
      "measures": [
        {
          "id": "orders",
          "label": "Orders shipped",
          "agg": "sum",
          "field": "orders",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "cases",
          "label": "Cases ordered",
          "agg": "sum",
          "field": "cases",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "shipped",
          "label": "Cases shipped",
          "agg": "sum",
          "field": "shipped",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "backorder",
          "label": "Backordered cases",
          "agg": "diff",
          "a": "cases",
          "b": "shipped",
          "unit": "count",
          "format": "N",
          "inv": true
        },
        {
          "id": "ontime",
          "label": "On-time orders",
          "agg": "sum",
          "field": "ontime",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "otifN",
          "label": "OTIF orders",
          "agg": "sum",
          "field": "otif",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "ot",
          "label": "On-time %",
          "agg": "ratio",
          "num": "ontime",
          "den": "orders",
          "unit": "pct",
          "format": "pc"
        },
        {
          "id": "fill",
          "label": "Fill rate",
          "agg": "ratio",
          "num": "shipped",
          "den": "cases",
          "unit": "pct",
          "format": "pc"
        },
        {
          "id": "otif",
          "label": "OTIF",
          "agg": "ratio",
          "num": "otifN",
          "den": "orders",
          "unit": "pct",
          "format": "pc"
        },
        {
          "id": "freight",
          "label": "Freight cost",
          "agg": "sum",
          "field": "freight",
          "unit": "money",
          "format": "eur",
          "inv": true
        },
        {
          "id": "fpo",
          "label": "Freight per order",
          "agg": "ratio",
          "num": "freight",
          "den": "orders",
          "unit": "money",
          "format": "eurF",
          "inv": true
        }
      ]
    },
    "filters": {
      "date": {
        "levels": [
          "year",
          "quarter",
          "month"
        ],
        "default": {
          "y": 2025,
          "q": null,
          "m": null
        }
      },
      "dims": [
        {
          "id": "wh",
          "label": "Warehouse",
          "control": "dropdown",
          "allLabel": "All warehouses",
          "pill": "Warehouse"
        },
        {
          "id": "region",
          "label": "Region",
          "control": "dropdown",
          "allLabel": "All regions",
          "pill": "Region"
        }
      ]
    },
    "kpiBand": [
      {
        "id": "otif",
        "label": "OTIF (target 92%)",
        "measure": "otif",
        "span": 1
      },
      {
        "id": "ot",
        "label": "On-time (target 95%)",
        "measure": "ot",
        "span": 1
      },
      {
        "id": "fill",
        "label": "Fill rate (target 98%)",
        "measure": "fill",
        "span": 1
      },
      {
        "id": "fpo",
        "label": "Freight per order",
        "measure": "fpo",
        "span": 1,
        "inv": true
      },
      {
        "id": "orders",
        "label": "Orders shipped",
        "measure": "orders",
        "span": 1
      }
    ],
    "pages": [
      {
        "id": "service",
        "title": "Service level",
        "subtitle": "Atlanta drags OTIF below target; the Southeast and Florida feel it first",
        "nav": "Service level",
        "rows": [
          {
            "visuals": [
              {
                "type": "heatmap",
                "span": 3,
                "h": 200,
                "title": "OTIF by warehouse and region · {period}",
                "subtitle": "darker = better; click a row to filter the warehouse",
                "bind": {
                  "dim": "wh",
                  "measure": "otif",
                  "by": "region"
                }
              },
              {
                "type": "gauge",
                "span": 2,
                "h": 200,
                "title": "Service KPIs against target",
                "bind": {
                  "misure": [
                    {
                      "measure": "otif",
                      "target": 0.92,
                      "targetLabel": "target"
                    },
                    {
                      "measure": "ot",
                      "target": 0.95,
                      "targetLabel": "target"
                    },
                    {
                      "measure": "fill",
                      "target": 0.98,
                      "targetLabel": "target"
                    }
                  ]
                }
              }
            ]
          },
          {
            "flex": true,
            "visuals": [
              {
                "type": "matrix",
                "span": 5,
                "title": "Warehouses · service and cost · {period}",
                "bind": {
                  "dim": "wh",
                  "label": "Warehouse",
                  "sort": "orders",
                  "drill": true,
                  "totalsLabel": "Network",
                  "columns": [
                    {
                      "measure": "orders",
                      "label": "Orders"
                    },
                    {
                      "measure": "orders",
                      "label": "{basis}",
                      "kind": "var"
                    },
                    {
                      "measure": "ot",
                      "label": "On-time %",
                      "kind": "heat",
                      "scale": [
                        0.88,
                        0.97
                      ]
                    },
                    {
                      "measure": "fill",
                      "label": "Fill rate",
                      "kind": "heat",
                      "scale": [
                        0.93,
                        0.99
                      ]
                    },
                    {
                      "measure": "otif",
                      "label": "OTIF",
                      "kind": "heat",
                      "scale": [
                        0.84,
                        0.94
                      ]
                    },
                    {
                      "measure": "otif",
                      "label": "OTIF {basis}",
                      "kind": "var"
                    },
                    {
                      "measure": "backorder",
                      "label": "Backordered cases",
                      "inv": true
                    },
                    {
                      "measure": "fpo",
                      "label": "Freight / order",
                      "inv": true
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "id": "trend",
        "title": "Trends and targets",
        "subtitle": "Three years of service: which regions sit furthest from the OTIF target",
        "nav": "Trends & targets",
        "rows": [
          {
            "visuals": [
              {
                "type": "colline",
                "span": 3,
                "h": 200,
                "title": "Orders per month, {y} vs {py}, with OTIF",
                "bind": {
                  "measure": "orders",
                  "line": "otif"
                }
              },
              {
                "type": "hbar",
                "span": 2,
                "h": 200,
                "title": "Regions furthest from the OTIF target",
                "bind": {
                  "dim": "region",
                  "measure": "otif",
                  "order": "asc",
                  "top": 5,
                  "subMeasure": "fill",
                  "subUnit": " fill"
                }
              }
            ]
          },
          {
            "flex": true,
            "visuals": [
              {
                "type": "matrix",
                "span": 5,
                "title": "Regions · service and cost · {period}",
                "bind": {
                  "dim": "region",
                  "label": "Region",
                  "sort": "orders",
                  "drill": false,
                  "totalsLabel": "Network",
                  "columns": [
                    {
                      "measure": "orders",
                      "label": "Orders"
                    },
                    {
                      "measure": "ot",
                      "label": "On-time %",
                      "kind": "heat",
                      "scale": [
                        0.88,
                        0.97
                      ]
                    },
                    {
                      "measure": "fill",
                      "label": "Fill rate",
                      "kind": "heat",
                      "scale": [
                        0.93,
                        0.99
                      ]
                    },
                    {
                      "measure": "otif",
                      "label": "OTIF",
                      "kind": "heat",
                      "scale": [
                        0.84,
                        0.94
                      ]
                    },
                    {
                      "measure": "otif",
                      "label": "OTIF {basis}",
                      "kind": "var"
                    },
                    {
                      "measure": "freight",
                      "label": "Freight cost",
                      "inv": true
                    },
                    {
                      "measure": "fpo",
                      "label": "Freight / order",
                      "inv": true
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
    "drill": {
      "dim": "wh",
      "page": {
        "id": "__drill__",
        "title": "{drill}",
        "drillHeader": "{period} · {basis}",
        "backLabel": "Back to network",
        "subtitle": "Regions served and monthly service from this warehouse",
        "rows": [
          {
            "flex": true,
            "visuals": [
              {
                "type": "colline",
                "span": 3,
                "h": 300,
                "title": "Orders per month with OTIF",
                "bind": {
                  "measure": "orders",
                  "line": "otif"
                }
              },
              {
                "type": "gauge",
                "span": 2,
                "h": 300,
                "title": "Service KPIs against target",
                "bind": {
                  "misure": [
                    {
                      "measure": "otif",
                      "target": 0.92,
                      "targetLabel": "target"
                    },
                    {
                      "measure": "ot",
                      "target": 0.95,
                      "targetLabel": "target"
                    },
                    {
                      "measure": "fill",
                      "target": 0.98,
                      "targetLabel": "target"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  },
