                      "label": "Margine %",
                      "kind": "heat",
                      "scale": [
                        0.05,
                        0.28
                      ]
                    },
                    {
                      "measure": "mgpct",
                      "label": "Margine {basis}",
                      "kind": "var"
                    },
                    {
                      "measure": "scontrini",
                      "label": "Scontrini"
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "id": "prodotti",
        "title": "Prodotti e punti vendita",
