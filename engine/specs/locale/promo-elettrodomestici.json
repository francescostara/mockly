          "allLabel": "Tutte",
          "pill": "Categoria"
        },
        {
          "id": "sede",
          "label": "Punto vendita",
          "control": "dropdown",
          "allLabel": "Tutti",
          "pill": "Sede"
        }
      ]
    },
