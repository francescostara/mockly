                      "dim": "prod",
                      "measure": "quotaPromo",
                      "detail": true,
                      "parent": "cat",
                      "top": 6,
                      "order": "asc",
                      "subMeasure": "netto"
                    }
                  }
                ]
              },
              {
                "type": "heatmap",
                "span": 3,
                "h": 200,
                "title": "Fatturato per punto vendita e campagna · {period}",
                "subtitle": "piu scuro = sede piu forte in quella campagna; clicca per filtrare la sede",
                "bind": {
                  "dim": "sede",
                  "measure": "netto",
                  "by": "campagna",
                  "per": "colonna"
                }
              }
            ]
          },
          {
            "flex": true,
            "visuals": [
              {
                "type": "matrix",
                "span": 5,
                "title": "Categorie · {period}",
                "bind": {
                  "dim": "cat",
                  "label": "Categoria",
                  "sort": "netto",
                  "drill": false,
                  "totalsLabel": "Totale",
                  "columns": [
                    {
                      "measure": "netto",
                      "label": "Fatturato netto"
                    },
                    {
                      "measure": "netto",
                      "label": "{basis}",
                      "kind": "var"
                    },
                    {
                      "measure": "quotaPromo",
                      "label": "Quota in promozione",
                      "kind": "heat",
                      "scale": [
