        "rows": [
          {
            "visuals": [
              {
                "type": "colline",
                "span": 3,
                "h": 190,
                "title": "Fatturato netto per mese, {y} contro {py}, con la quota in promozione",
                "bind": {
                  "measure": "netto",
                  "line": "quotaPromo"
                }
              },
              {
                "type": "hbar",
                "span": 2,
                "h": 190,
                "title": "Vendite incrementali per campagna · {period}",
                "bind": {
                  "dim": "campagna",
                  "measure": "incr",
                  "subMeasure": "uplift",
                  "subUnit": " uplift",
                  "top": 5
                }
              }
