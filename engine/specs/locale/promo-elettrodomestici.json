            "flex": true,
            "visuals": [
              {
                "type": "matrix",
                "span": 5,
                "title": "Campagne a confronto · {period}",
                "bind": {
                  "dim": "campagna",
                  "label": "Campagna",
                  "sort": "netto",
                  "drill": true,
                  "totalsLabel": "Totale",
                  "columns": [
                    {
                      "measure": "netto",
                      "label": "Fatturato netto"
                    },
                    {
                      "measure": "netto",
                      "label": "{basis}",
                      "kind": "var"
                    },
                    {
                      "measure": "incr",
                      "label": "Vendite incrementali"
                    },
                    {
                      "measure": "uplift",
