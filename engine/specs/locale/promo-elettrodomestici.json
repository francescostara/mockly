                    {
                      "measure": "promoGen",
                      "label": "Promo generali"
                    },
                    {
                      "measure": "promoCat",
                      "label": "Promo di categoria"
                    },
                    {
                      "measure": "scontoPct",
                      "label": "Sconto medio",
                      "inv": true
                    },
                    {
                      "measure": "mgpct",
                      "label": "Margine %"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
