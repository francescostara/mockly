    "aesthetic": "corporate-sober",
    "skin": {
      "shell": "rail",
      "palette": "slate-freddo",
      "tipografia": "umanista",
      "densita": "denso",
      "banda": "blocco"
    },
    "archetype": "scorecard",
    "grid": {
      "contentWidth": 1044,
      "gutter": 8,
      "columns": 5
    },
    "model": {
      "sums": [
        "lordo",
        "sconti",
        "netto",
        "costo",
        "margine",
        "promo",
        "incr",
        "promoGen",
        "promoCat",
        "scontrini",
        "pezzi"
      ],
      "measures": [
        {
          "id": "lordo",
          "label": "Vendite a listino",
          "agg": "sum",
          "field": "lordo",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "sconti",
          "label": "Sconti concessi",
          "agg": "sum",
          "field": "sconti",
          "unit": "money",
          "format": "eur",
          "inv": true
        },
        {
          "id": "netto",
          "label": "Fatturato netto",
          "agg": "sum",
          "field": "netto",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "margine",
          "label": "Margine lordo",
          "agg": "sum",
          "field": "margine",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "mgpct",
          "label": "Margine %",
          "agg": "ratio",
          "num": "margine",
          "den": "netto",
          "unit": "pct",
          "format": "pc"
        },
        {
          "id": "scontoPct",
          "label": "Sconto medio",
          "agg": "ratio",
          "num": "sconti",
          "den": "lordo",
          "unit": "pct",
          "format": "pc",
          "inv": true
        },
        {
          "id": "promo",
          "label": "Vendite in promozione",
          "agg": "sum",
          "field": "promo",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "quotaPromo",
          "label": "Quota in promozione",
          "agg": "ratio",
          "num": "promo",
          "den": "netto",
          "unit": "pct",
          "format": "pc"
        },
        {
          "id": "incr",
          "label": "Vendite incrementali",
          "agg": "sum",
          "field": "incr",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "basePromo",
          "label": "Vendite attese in promozione",
          "agg": "diff",
          "a": "promo",
          "b": "incr",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "uplift",
          "label": "Uplift",
          "agg": "ratio",
          "num": "incr",
          "den": "basePromo",
          "unit": "pct",
          "format": "pc"
        },
        {
          "id": "promoGen",
          "label": "Promo generali",
          "agg": "sum",
          "field": "promoGen",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "promoCat",
          "label": "Promo di categoria",
          "agg": "sum",
          "field": "promoCat",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "scontrini",
          "label": "Scontrini",
          "agg": "sum",
          "field": "scontrini",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "scontrino",
          "label": "Scontrino medio",
          "agg": "ratio",
          "num": "netto",
          "den": "scontrini",
          "unit": "money",
          "format": "eurF"
        },
        {
          "id": "pezzi",
          "label": "Pezzi venduti",
          "agg": "sum",
          "field": "pezzi",
          "unit": "count",
          "format": "N"
        }
      ]
    },
    "filters": {
      "date": {
        "levels": [
          "year",
          "quarter",
          "month"
        ],
        "default": {
          "y": 2025,
          "q": null,
          "m": null
        }
      },
      "dims": [
        {
          "id": "campagna",
