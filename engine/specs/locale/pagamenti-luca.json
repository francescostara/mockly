{
 "spec": {
  "meta": {
   "title": "Payment Cut-off Control",
   "subtitle": "Cut-off compliance, late payments and STP · {period}",
   "brand": {
    "name": "Helvetia Private Bank",
    "tagline": "Payment Operations"
   },
   "locale": "en-US",
   "currency": "CHF ",
   "months": [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec"
   ],
   "updated": "Data as of Dec 31, 2025",
   "source": "Source: payment hub and SWIFT gateway · cut-offs in CET",
   "watermark": "Demo mockup · synthetic data",
   "varianze": "finanza"
  },
  "aesthetic": "corporate-sober",
  "skin": {
   "shell": "rail",
   "palette": "slate-freddo",
   "tipografia": "tecnico",
   "densita": "medio",
   "banda": "box"
  },
  "archetype": "operational",
  "grid": {
   "contentWidth": 1044,
   "gutter": 12,
   "columns": 4
  },
  "model": {
   "sums": [
    "payments",
    "value",
    "late",
    "lateVal",
    "ontime",
    "cClient",
    "cRepair",
    "cSanct",
    "cFunds",
    "cSystem",
    "manual",
    "stp",
    "vdb",
    "cost",
    "queueN",
    "queueVal",
    "riskN",
    "riskVal"
   ],
   "measures": [
    {
     "id": "payments",
     "label": "Payments",
     "agg": "sum",
     "field": "payments",
     "unit": "count",
     "format": "N",
     "description": "Every outgoing payment instructed in the period, whatever its status"
    },
    {
     "id": "value",
     "label": "Value processed",
     "agg": "sum",
     "field": "value",
     "unit": "money",
     "format": "eur"
    },
    {
     "id": "late",
     "label": "Late payments",
     "agg": "sum",
     "field": "late",
     "unit": "count",
     "format": "N",
     "inv": true,
     "description": "Payments executed after the cut-off of their currency, so they lose the requested value date"
    },
    {
     "id": "lateVal",
     "label": "Late value",
     "agg": "sum",
     "field": "lateVal",
     "unit": "money",
     "format": "eur",
     "inv": true
    },
    {
     "id": "ontime",
     "label": "Before cut-off",
     "agg": "sum",
     "field": "ontime",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "comp",
     "label": "Cut-off compliance",
     "agg": "ratio",
     "num": "ontime",
     "den": "payments",
     "unit": "pct",
     "format": "pc",
     "target": 0.98,
     "description": "The share of payments executed before the cut-off of their currency (CHF 16:00, SEPA 14:00, other EUR 15:00, USD 18:00, GBP 16:15, JPY/HKD/SGD 16:00 the day before value date)"
    },
    {
     "id": "lateRate",
     "label": "Late %",
     "agg": "ratio",
     "num": "late",
     "den": "payments",
     "unit": "pct",
     "format": "pc",
     "inv": true,
     "target": 0.02
    },
    {
     "id": "cClient",
     "label": "Instruction after cut-off",
     "agg": "sum",
     "field": "cClient",
     "unit": "count",
     "format": "N",
     "inv": true
    },
    {
     "id": "cRepair",
     "label": "Manual repair",
     "agg": "sum",
     "field": "cRepair",
     "unit": "count",
     "format": "N",
     "inv": true
    },
    {
     "id": "cSanct",
     "label": "Sanctions screening hold",
     "agg": "sum",
     "field": "cSanct",
     "unit": "count",
     "format": "N",
     "inv": true
    },
    {
     "id": "cFunds",
     "label": "Insufficient funds check",
     "agg": "sum",
     "field": "cFunds",
     "unit": "count",
     "format": "N",
     "inv": true
    },
    {
     "id": "cSystem",
     "label": "Counterparty / system",
     "agg": "sum",
     "field": "cSystem",
     "unit": "count",
     "format": "N",
     "inv": true
    },
    {
     "id": "pClient",
     "label": "Client late %",
     "agg": "ratio",
     "num": "cClient",
     "den": "late",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "pRepair",
     "label": "Repair %",
     "agg": "ratio",
     "num": "cRepair",
     "den": "late",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "pSanct",
     "label": "Sanctions %",
     "agg": "ratio",
     "num": "cSanct",
     "den": "late",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "pFunds",
     "label": "Funds %",
     "agg": "ratio",
     "num": "cFunds",
     "den": "late",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "pSystem",
     "label": "System %",
     "agg": "ratio",
     "num": "cSystem",
     "den": "late",
     "unit": "pct",
     "format": "pc"
    },
    {
     "id": "manual",
     "label": "Manual repairs",
     "agg": "sum",
     "field": "manual",
     "unit": "count",
     "format": "N",
     "inv": true
    },
    {
     "id": "stpN",
     "label": "Straight-through",
     "agg": "sum",
     "field": "stp",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "stpR",
     "label": "STP rate",
     "agg": "ratio",
     "num": "stpN",
     "den": "payments",
     "unit": "pct",
     "format": "pc",
     "target": 0.95
    },
    {
     "id": "vdb",
     "label": "Value date breaches",
     "agg": "sum",
     "field": "vdb",
     "unit": "count",
     "format": "N",
     "inv": true
    },
    {
     "id": "cost",
     "label": "Cost of late payments",
     "agg": "sum",
     "field": "cost",
     "unit": "money",
     "format": "eur",
     "inv": true,
     "description": "Interest compensation paid to clients and fees for payments that missed their value date"
    },
    {
     "id": "queueN",
     "label": "Payments in queue",
     "agg": "last",
     "field": "queueN",
     "unit": "count",
     "format": "N"
    },
    {
     "id": "queueVal",
     "label": "Value in queue",
     "agg": "last",
     "field": "queueVal",
     "unit": "money",
     "format": "eur"
    },
    {
     "id": "riskN",
     "label": "Payments at risk",
     "agg": "last",
     "field": "riskN",
     "unit": "count",
     "format": "N",
     "inv": true
    },
    {
     "id": "riskVal",
     "label": "Value at risk in queue",
     "agg": "last",
     "field": "riskVal",
     "unit": "money",
     "format": "eur",
     "inv": true,
     "description": "The value of payments still waiting in the queue with less than 30 minutes left before the cut-off of their currency, on the last day of the period"
    }
   ]
  },
  "filters": {
   "date": {
    "levels": [
     "year",
     "quarter",
     "month"
    ],
    "default": {
     "y": 2025,
     "q": null,
     "m": null
    }
   },
   "dims": [
    {
     "id": "ccy",
     "label": "Currency",
     "control": "dropdown",
     "allLabel": "All currencies",
     "pill": "Currency"
    },
    {
     "id": "div",
     "label": "Division",
     "control": "dropdown",
     "allLabel": "All divisions",
     "pill": "Division"
    },
    {
     "id": "ptype",
     "label": "Payment type",
     "control": "dropdown",
     "allLabel": "All types",
     "pill": "Type"
    }
   ]
  },
  "kpiBand": [
   {
    "id": "comp",
    "label": "Cut-off compliance",
    "measure": "comp",
    "span": 1
   },
   {
    "id": "late",
    "label": "Late payments",
    "measure": "late",
    "span": 1,
    "inv": true,
    "of": "payments"
   },
   {
    "id": "riskVal",
    "label": "Value at risk in queue",
    "measure": "riskVal",
    "span": 1,
    "inv": true,
    "of": "queueVal"
   },
   {
    "id": "cost",
    "label": "Cost of late payments",
    "measure": "cost",
    "span": 1,
    "inv": true
   }
  ],
  "pages": [
   {
    "id": "monitor",
    "title": "Cut-off monitor",
    "subtitle": "Above target overall, but 1 USD payment in 25 and 1 JPY/HKD/SGD payment in 16 arrive late",
    "nav": "Cut-off monitor",
    "rows": [
     {
      "visuals": [
       {
        "type": "heatmap",
        "span": 2,
        "h": 170,
        "title": "Cross-border currencies miss the cut-off in every division",
        "subtitle": "cut-off compliance by currency and division · {period}",
        "bind": {
         "dim": "ccy",
         "measure": "comp",
         "by": "div"
        }
       },
       {
        "type": "colline",
        "span": 2,
        "h": 170,
        "title": "Above the 98% target every month: the average hides the cross-border gap",
        "subtitle": "payments per month, {y} vs {py}, with compliance against the 98% target",
        "bind": {
         "measure": "payments",
         "line": "comp"
        }
       }
      ]
     },
     {
      "flex": true,
      "visuals": [
       {
        "id": "queue",
        "span": 3,
        "viste": [
         {
          "type": "matrix",
          "etichetta": "By currency",
          "title": "USD and JPY/HKD/SGD carry the late payments and the value at risk · {period}",
          "bind": {
           "dim": "ccy",
           "label": "Currency · cut-off",
           "sort": "payments",
           "drill": true,
           "totalsLabel": "All currencies",
           "columns": [
            {
             "measure": "payments",
             "label": "Payments"
            },
            {
             "measure": "late",
             "label": "Late",
             "inv": true
            },
            {
             "measure": "lateRate",
             "label": "Late %"
            },
            {
             "measure": "comp",
             "label": "Compliance {basis}",
             "kind": "var"
            },
            {
             "measure": "riskN",
             "label": "At risk (<30 min)",
             "inv": true
            },
            {
             "measure": "riskVal",
             "label": "Value at risk",
             "inv": true
            },
            {
             "measure": "lateVal",
             "label": "Late value",
             "inv": true
            }
           ]
          }
         },
         {
          "type": "matrix",
          "etichetta": "By destination country",
          "title": "UAE and Hong Kong: 1 payment in 15 arrives late, half of them held by sanctions screening · {period}",
          "bind": {
           "dim": "country",
           "label": "Destination country",
           "sort": "value",
           "drill": false,
           "totalsLabel": "All countries",
           "columns": [
            {
             "measure": "value",
             "label": "Value sent"
            },
            {
             "measure": "value",
             "label": "Share",
             "kind": "share"
            },
            {
             "measure": "payments",
             "label": "Payments"
            },
            {
             "measure": "late",
             "label": "Late",
             "inv": true
            },
            {
             "measure": "lateRate",
             "label": "Late %"
            },
            {
             "measure": "pSanct",
             "label": "Late for sanctions hold",
             "kind": "heat",
             "scale": [
              0.02,
              0.4
             ]
            }
           ]
          }
         }
        ],
        "motivo": "altro-taglio"
       },
       {
        "type": "hbar",
        "span": 1,
        "h": 290,
        "title": "USD: as many payments at risk as CHF, six times the value",
        "bind": {
         "dim": "ccy",
         "measure": "riskVal",
         "top": 6,
         "subMeasure": "riskN",
         "subUnit": " payments"
        }
       }
      ]
     }
    ]
   },
   {
    "id": "causes",
    "title": "Root causes and STP",
    "subtitle": "Private Banking and Wealth Management repair 1 payment in 10 by hand; Corporate and Treasury run straight through",
    "nav": "Root causes & STP",
    "rows": [
     {
      "visuals": [
       {
        "type": "heatmap",
        "span": 2,
        "h": 170,
        "title": "Payments from Private Banking and Wealth Management need the most manual repair",
