{
  "_leggimi": [
    "Archetipo 2 — executive summary (SaaS per il board)",
    "Archetipo \"executive-summary\" — vedi skill/references/layout-archetypes.md.",
    "Firma strutturale: delta-card:1+trend:2 | hbar:2+gauge:1  ||  colline:3 | matrix:3",
    "Generato da engine/templates/executive-summary.js con `npm run templates`.",
    "NON modificare questo file a mano: la sorgente e lo scheletro, e questo ne e la copia."
  ],
  "spec": {
    "meta": {
      "title": "Northwind Cloud — sintesi per il consiglio",
      "subtitle": "Una cosa da sapere, e dove guardare se serve il dettaglio · {y}",
      "locale": "it-IT",
      "currency": "€",
      "months": [
        "Gen",
        "Feb",
        "Mar",
        "Apr",
        "Mag",
        "Giu",
        "Lug",
        "Ago",
        "Set",
        "Ott",
        "Nov",
        "Dic"
      ],
      "updated": "aggiornato il 2 set 2026",
      "watermark": "Mockup dimostrativo · dati sintetici"
    },
    "aesthetic": "executive-minimal",
    "skin": {
      "shell": "bare",
      "tipografia": "editoriale"
    },
    "archetype": "executive-summary",
    "grid": {
      "contentWidth": 1248,
      "gutter": 12,
      "columns": 3
    },
    "model": {
      "sums": [
        "mrr",
        "clienti",
        "mrrNuovo",
        "mrrEspansione",
        "mrrChurn",
        "spesaAcq",
        "mrrNetto"
      ],
      "measures": [
        {
          "id": "mrr",
          "label": "Ricorrente cumulato",
          "agg": "sum",
          "field": "mrr",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "mrrFine",
          "label": "MRR",
          "agg": "last",
          "field": "mrr",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "clienti",
          "label": "Clienti-mese",
          "agg": "sum",
          "field": "clienti",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "clientiFine",
          "label": "Clienti",
          "agg": "last",
          "field": "clienti",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "mrrNuovo",
          "label": "MRR nuovo",
          "agg": "sum",
          "field": "mrrNuovo",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "mrrEspansione",
          "label": "MRR espansione",
          "agg": "sum",
          "field": "mrrEspansione",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "mrrChurn",
          "label": "MRR perso",
          "agg": "sum",
          "field": "mrrChurn",
          "unit": "money",
          "format": "eur",
          "inv": true
        },
        {
          "id": "spesaAcq",
          "label": "Spesa di acquisizione",
          "agg": "sum",
          "field": "spesaAcq",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "nrr",
          "label": "NRR",
          "agg": "ratio",
          "num": "mrrNetto",
          "den": "mrr",
          "unit": "pct",
          "format": "pc"
        },
        {
          "id": "churnPc",
          "label": "Churn MRR",
          "agg": "ratio",
          "num": "mrrChurn",
          "den": "mrr",
          "unit": "pct",
          "format": "pc",
          "inv": true
        },
        {
          "id": "payback",
          "label": "CAC payback",
          "agg": "ratio",
          "num": "spesaAcq",
          "den": "mrrNuovo",
          "unit": "months",
          "format": "months",
          "inv": true
        },
        {
          "id": "arpa",
          "label": "ARPA",
          "agg": "ratio",
          "num": "mrr",
          "den": "clienti",
          "unit": "money",
          "format": "eurF"
        }
      ]
    },
    "filters": {
      "date": {
        "levels": [
          "year",
          "quarter",
          "month"
        ],
        "default": {
          "y": 2025,
          "q": null,
          "m": null
        }
      },
      "dims": [
        {
          "id": "piano",
          "label": "Piano",
          "control": "list",
          "allLabel": "Tutti",
          "pill": "Piano"
        },
        {
          "id": "canale",
          "label": "Canale",
          "control": "list",
          "allLabel": "Tutti",
          "pill": "Canale"
        }
      ]
    },
    "kpiBand": [
      {
        "id": "mrr",
        "label": "MRR",
        "measure": "mrrFine",
        "span": 1
      },
      {
        "id": "nrr",
        "label": "NRR",
        "measure": "nrr",
        "span": 1
      },
      {
        "id": "payback",
        "label": "CAC payback",
        "measure": "payback",
        "span": 1,
        "inv": true
      }
    ],
    "pages": [
      {
        "id": "sintesi",
        "title": "Sintesi",
        "nav": "Sintesi",
        "subtitle": "L'MRR cresce; a tenerlo su e l'espansione di Enterprise, non i nuovi logo",
        "rows": [
          {
            "visuals": [
              {
                "type": "delta-card",
                "span": 1,
                "h": 210,
                "title": "MRR",
                "bind": {
                  "measure": "mrrFine"
                }
              },
              {
                "type": "trend",
                "span": 2,
                "h": 210,
                "title": "MRR mensile — {y} vs {py}",
                "subtitle": "la linea tratteggiata e l'anno precedente",
                "legend": [
                  {
                    "l": "{y}",
                    "c": "var(--c2)"
                  },
                  {
                    "l": "{py}",
                    "dash": true
                  }
                ],
                "bind": {
                  "measure": "mrr"
                }
              }
            ]
          },
          {
            "visuals": [
              {
                "type": "hbar",
                "span": 2,
                "h": 168,
                "title": "MRR per piano — {period}",
                "subtitle": "Starter perde piu di quanto aggiunga",
                "bind": {
                  "dim": "piano",
                  "measure": "mrrFine"
                }
              },
              {
                "type": "gauge",
                "span": 1,
                "h": 168,
                "title": "NRR contro il 100%",
                "subtitle": "sotto il 100% il fatturato si erode da solo",
                "bind": {
                  "measure": "nrr",
                  "target": 1,
                  "targetLabel": "pareggio",
                  "max": 1.3
                }
              }
            ]
          }
        ]
      },
      {
        "id": "dettaglio",
        "title": "Dettaglio per piano",
        "nav": "Dettaglio",
        "subtitle": "Il movimento dell'MRR e i numeri per piano",
        "rows": [
          {
            "visuals": [
              {
                "type": "colline",
                "span": 3,
                "h": 176,
                "title": "MRR nuovo per mese, con il churn come linea",
                "bind": {
                  "measure": "mrrNuovo",
                  "line": "churnPc"
                }
              }
            ]
          },
          {
            "flex": true,
            "visuals": [
              {
                "type": "matrix",
                "span": 3,
                "title": "Dettaglio per piano — {period}",
                "bind": {
                  "dim": "piano",
                  "label": "Piano",
                  "sort": "mrr",
                  "drill": true,
                  "totalsLabel": "Totale",
                  "columns": [
                    {
                      "measure": "mrrFine",
                      "label": "MRR"
                    },
                    {
                      "measure": "mrrFine",
                      "label": "{basis}",
                      "kind": "var"
                    },
                    {
                      "measure": "clientiFine",
                      "label": "Clienti"
                    },
                    {
                      "measure": "arpa",
                      "label": "ARPA"
                    },
                    {
                      "measure": "churnPc",
                      "label": "Churn",
                      "kind": "heat",
                      "scale": [
                        0.004,
                        0.03
                      ],
                      "inv": true
                    },
                    {
                      "measure": "payback",
                      "label": "Payback"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
    "drill": {
      "dim": "piano",
      "page": {
        "id": "__drill__",
        "title": "{drill}",
        "drillHeader": "Dettaglio del piano — {period}",
        "backLabel": "Torna al dettaglio",
        "rows": [
          {
            "visuals": [
              {
                "type": "trend",
                "span": 2,
                "h": 200,
                "title": "MRR mensile — {drill}",
                "bind": {
                  "measure": "mrr"
                }
              },
              {
                "type": "hbar",
                "span": 1,
                "h": 200,
                "title": "MRR per canale",
                "bind": {
                  "dim": "canale",
                  "measure": "mrr"
                }
              }
            ]
          }
        ]
      }
    }
  },
