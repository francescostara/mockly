{
  "_leggimi": [
    "Archetipo 8 — operativo (capacita di una palestra)",
    "Archetipo \"operational\" — vedi skill/references/layout-archetypes.md.",
    "Firma strutturale: heatmap:2+hbar:1+gauge:1 | matrix:4",
    "Generato da engine/templates/operational.js con `npm run templates`.",
    "NON modificare questo file a mano: la sorgente e lo scheletro, e questo ne e la copia."
  ],
  "spec": {
    "meta": {
      "title": "Club Aurora — capacita e riempimento",
      "subtitle": "Dove le sale lavorano e dove restano aperte per niente · {y}",
      "locale": "it-IT",
      "currency": "€",
      "months": [
        "Gen",
        "Feb",
        "Mar",
        "Apr",
        "Mag",
        "Giu",
        "Lug",
        "Ago",
        "Set",
        "Ott",
        "Nov",
        "Dic"
      ],
      "updated": "aggiornato il 2 set 2026",
      "watermark": "Mockup dimostrativo · dati sintetici"
    },
    "aesthetic": "corporate-sober",
    "skin": {
      "palette": "salvia",
      "tipografia": "humanist",
      "densita": "denso"
    },
    "archetype": "operational",
    "grid": {
      "contentWidth": 1044,
      "gutter": 8,
      "columns": 4
    },
    "model": {
      "sums": [
        "ricavi",
        "soci",
        "presenze",
        "capacita",
        "abbandoni"
      ],
      "measures": [
        {
          "id": "ricavi",
          "label": "Ricavi",
          "agg": "sum",
          "field": "ricavi",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "soci",
          "label": "Soci-mese",
          "agg": "sum",
          "field": "soci",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "sociAttivi",
          "label": "Soci attivi",
          "agg": "last",
          "field": "soci",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "presenze",
          "label": "Presenze",
          "agg": "sum",
          "field": "presenze",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "capacita",
          "label": "Posti disponibili",
          "agg": "sum",
          "field": "capacita",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "abbandoni",
          "label": "Abbandoni",
          "agg": "sum",
          "field": "abbandoni",
          "unit": "count",
          "format": "N",
          "inv": true
        },
        {
          "id": "riempimento",
          "label": "Riempimento",
          "agg": "ratio",
          "num": "presenze",
          "den": "capacita",
          "unit": "pct",
          "format": "pc"
        },
        {
          "id": "churnPc",
          "label": "Churn mensile",
          "agg": "ratio",
          "num": "abbandoni",
          "den": "soci",
          "unit": "pct",
          "format": "pc",
          "inv": true
        },
        {
          "id": "ricavoSocio",
          "label": "Ricavo per socio (mese)",
          "agg": "ratio",
          "num": "ricavi",
          "den": "soci",
          "unit": "money",
          "format": "eurF"
        }
      ]
    },
    "filters": {
      "date": {
        "levels": [
          "year",
          "quarter",
          "month"
        ],
        "default": {
          "y": 2025,
          "q": null,
          "m": null
        }
      },
      "dims": [
        {
          "id": "corso",
          "label": "Corso",
          "control": "list",
          "allLabel": "Tutti",
          "pill": "Corso"
        },
        {
          "id": "fascia",
          "label": "Fascia",
          "control": "list",
          "allLabel": "Tutte",
          "pill": "Fascia"
        }
      ]
    },
    "kpiBand": [
      {
        "id": "soci",
        "label": "Soci attivi",
        "measure": "sociAttivi",
        "span": 1
      },
      {
        "id": "riempimento",
        "label": "Riempimento",
        "measure": "riempimento",
        "span": 1
      },
      {
        "id": "churnPc",
        "label": "Churn mensile",
        "measure": "churnPc",
        "span": 1,
        "inv": true
      },
      {
        "id": "ricavoSocio",
        "label": "Ricavo per socio / mese",
        "measure": "ricavoSocio",
        "span": 1
      }
    ],
    "pages": [
      {
        "id": "main",
        "title": "Capacita e riempimento",
        "subtitle": "La banda fredda del pranzo attraversa tutta la settimana e nessun totale la mostra",
        "rows": [
          {
            "visuals": [
              {
                "type": "heatmap",
                "span": 2,
                "h": 176,
                "title": "Presenze per corso e fascia — {y}",
                "subtitle": "piu scuro = piu presenze; clicca una cella per filtrare il corso",
                "bind": {
                  "dim": "corso",
                  "measure": "presenze",
                  "by": "fascia"
                }
              },
              {
                "type": "hbar",
                "span": 1,
                "h": 176,
                "title": "Riempimento per corso",
                "subtitle": "Nuoto e Yoga a meta sala",
                "bind": {
                  "dim": "corso",
                  "measure": "riempimento"
                }
              },
              {
                "type": "gauge",
                "span": 1,
                "h": 176,
                "title": "Riempimento",
                "subtitle": "soglia di sostenibilita 70%",
                "bind": {
                  "measure": "riempimento",
                  "target": 0.7,
                  "targetLabel": "soglia",
                  "max": 1
                }
              }
            ]
          },
          {
            "flex": true,
            "visuals": [
              {
                "type": "matrix",
                "span": 4,
                "title": "Corsi — presenze, capacita e abbandoni · {period}",
                "bind": {
                  "dim": "corso",
                  "label": "Corso",
                  "sort": "presenze",
                  "drill": true,
                  "totalsLabel": "Totale club",
                  "columns": [
                    {
                      "measure": "presenze",
                      "label": "Presenze"
                    },
                    {
                      "measure": "capacita",
                      "label": "Posti"
                    },
                    {
                      "measure": "riempimento",
                      "label": "Riempimento",
                      "kind": "heat",
                      "scale": [
                        0.45,
                        0.85
                      ]
                    },
                    {
                      "measure": "sociAttivi",
                      "label": "Soci"
                    },
                    {
                      "measure": "churnPc",
                      "label": "Churn",
                      "kind": "heat",
                      "scale": [
                        0.025,
                        0.06
                      ],
                      "inv": true
                    },
                    {
                      "measure": "ricavoSocio",
                      "label": "Ricavo/socio"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
    "drill": {
      "dim": "corso",
      "page": {
        "id": "__drill__",
        "title": "{drill}",
        "drillHeader": "Dettaglio del corso — {period}",
        "backLabel": "Torna alla capacita",
        "rows": [
          {
            "visuals": [
              {
                "type": "trend",
                "span": 2,
                "h": 190,
                "title": "Presenze mensili — {drill}",
                "bind": {
                  "measure": "presenze"
                }
              },
              {
                "type": "hbar",
                "span": 2,
                "h": 190,
                "title": "Presenze per fascia",
                "bind": {
                  "dim": "fascia",
                  "measure": "presenze"
                }
              }
            ]
          }
        ]
      }
    }
