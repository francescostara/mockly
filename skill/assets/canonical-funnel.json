{
  "_leggimi": [
    "Archetipo 3 — funnel (pipeline B2B per fonte)",
    "Archetipo \"funnel\" — vedi skill/references/layout-archetypes.md.",
    "Firma strutturale: funnel:2+hbar:2 | colline:2+stack100:2 | matrix:4",
    "Generato da engine/templates/funnel.js con `npm run templates`.",
    "NON modificare questo file a mano: la sorgente e lo scheletro, e questo ne e la copia."
  ],
  "spec": {
    "meta": {
      "title": "Pipeline commerciale — dove si perdono le trattative",
      "subtitle": "Dal primo contatto al contratto, per fonte · {y}",
      "locale": "it-IT",
      "currency": "€",
      "months": [
        "Gen",
        "Feb",
        "Mar",
        "Apr",
        "Mag",
        "Giu",
        "Lug",
        "Ago",
        "Set",
        "Ott",
        "Nov",
        "Dic"
      ],
      "updated": "aggiornato il 2 set 2026",
      "watermark": "Mockup dimostrativo · dati sintetici"
    },
    "aesthetic": "corporate-sober",
    "skin": {
      "palette": "slate-freddo",
      "tipografia": "slab"
    },
    "archetype": "funnel",
    "grid": {
      "contentWidth": 1044,
      "gutter": 12,
      "columns": 4
    },
    "model": {
      "sums": [
        "lead",
        "qualificate",
        "demo",
        "vinte",
        "valore",
        "giorniCiclo"
      ],
      "measures": [
        {
          "id": "lead",
          "label": "Lead",
          "agg": "sum",
          "field": "lead",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "qualificate",
          "label": "Qualificate",
          "agg": "sum",
          "field": "qualificate",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "demo",
          "label": "Demo",
          "agg": "sum",
          "field": "demo",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "vinte",
          "label": "Vinte",
          "agg": "sum",
          "field": "vinte",
          "unit": "count",
          "format": "N"
        },
        {
          "id": "valore",
          "label": "Valore vinto",
          "agg": "sum",
          "field": "valore",
          "unit": "money",
          "format": "eur"
        },
        {
          "id": "winRate",
          "label": "Win rate",
          "agg": "ratio",
          "num": "vinte",
          "den": "qualificate",
          "unit": "pct",
          "format": "pc"
        },
        {
          "id": "convLead",
          "label": "Conversione da lead",
          "agg": "ratio",
          "num": "vinte",
          "den": "lead",
          "unit": "pct",
          "format": "pc"
        },
        {
          "id": "qualRate",
          "label": "Tasso di qualifica",
          "agg": "ratio",
          "num": "qualificate",
          "den": "lead",
          "unit": "pct",
          "format": "pc"
        },
        {
          "id": "dealMedio",
          "label": "Valore medio",
          "agg": "ratio",
          "num": "valore",
          "den": "vinte",
          "unit": "money",
          "format": "eurF"
        },
        {
          "id": "ciclo",
          "label": "Ciclo (giorni)",
          "agg": "ratio",
          "num": "giorniCiclo",
          "den": "vinte",
          "unit": "days",
          "format": "days",
          "inv": true
        }
      ]
    },
    "filters": {
      "date": {
        "levels": [
          "year",
          "quarter",
          "month"
        ],
        "default": {
          "y": 2025,
          "q": null,
          "m": null
        }
      },
      "dims": [
        {
          "id": "fonte",
          "label": "Fonte",
          "control": "list",
          "allLabel": "Tutte",
          "pill": "Fonte"
        },
        {
          "id": "segmento",
          "label": "Segmento",
          "control": "list",
          "allLabel": "Tutti",
          "pill": "Segm."
        }
      ]
    },
    "kpiBand": [
      {
        "id": "lead",
        "label": "Lead",
        "measure": "lead",
        "span": 1
      },
      {
        "id": "vinte",
        "label": "Trattative vinte",
        "measure": "vinte",
        "span": 1
      },
      {
        "id": "winRate",
        "label": "Win rate",
        "measure": "winRate",
        "span": 1
      },
      {
        "id": "dealMedio",
        "label": "Valore medio",
        "measure": "dealMedio",
        "span": 1
      }
    ],
    "pages": [
      {
        "id": "main",
        "title": "Conversione",
        "subtitle": "Il collo di bottiglia e la qualifica: due lead su tre non arrivano alla demo",
        "rows": [
          {
            "visuals": [
              {
                "type": "funnel",
                "span": 2,
                "h": 168,
                "title": "Dal lead al contratto — {period}",
                "subtitle": "a destra di ogni stadio, la conversione dal precedente",
                "bind": {
                  "stages": [
                    {
                      "measure": "lead",
                      "label": "Lead",
                      "c": "var(--c1)"
                    },
                    {
                      "measure": "qualificate",
                      "label": "Qualificate",
                      "c": "var(--c2)"
                    },
                    {
                      "measure": "demo",
                      "label": "Demo",
                      "c": "var(--c3)"
                    },
                    {
                      "measure": "vinte",
                      "label": "Vinte",
                      "c": "var(--c4)"
                    }
                  ]
                }
              },
              {
                "type": "hbar",
                "span": 2,
                "h": 168,
                "title": "Win rate per fonte",
                "subtitle": "la fonte che porta piu lead non e quella che chiude",
                "bind": {
                  "dim": "fonte",
                  "measure": "winRate"
                }
              }
            ]
          },
          {
            "visuals": [
              {
                "type": "colline",
                "span": 2,
                "h": 138,
                "title": "Lead per mese, con il win rate come linea",
                "bind": {
                  "measure": "lead",
                  "line": "winRate"
                }
              },
              {
                "type": "stack100",
                "span": 2,
                "h": 138,
                "title": "Composizione delle vinte per segmento",
                "bind": {
                  "dim": "segmento",
                  "measure": "vinte",
                  "by": "q"
                }
              }
            ]
          },
          {
            "flex": true,
            "visuals": [
              {
                "type": "matrix",
                "span": 4,
                "title": "Fonti — volume, conversione e valore · {period}",
                "bind": {
                  "dim": "fonte",
                  "label": "Fonte",
                  "sort": "valore",
                  "drill": true,
                  "totalsLabel": "Totale pipeline",
                  "columns": [
                    {
                      "measure": "lead",
                      "label": "Lead"
                    },
                    {
                      "measure": "qualRate",
                      "label": "Qualifica"
                    },
                    {
                      "measure": "winRate",
                      "label": "Win rate",
                      "kind": "heat",
                      "scale": [
                        0.1,
                        0.45
                      ]
                    },
                    {
                      "measure": "vinte",
                      "label": "Vinte"
                    },
                    {
                      "measure": "valore",
                      "label": "Valore"
                    },
                    {
                      "measure": "ciclo",
                      "label": "Ciclo"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
    "drill": {
      "dim": "fonte",
      "page": {
        "id": "__drill__",
        "title": "{drill}",
        "drillHeader": "Dettaglio della fonte — {period}",
        "backLabel": "Torna alla conversione",
        "rows": [
          {
            "visuals": [
              {
                "type": "trend",
                "span": 2,
                "h": 190,
                "title": "Lead mensili — {drill}",
                "bind": {
                  "measure": "lead"
                }
              },
              {
                "type": "hbar",
                "span": 2,
                "h": 190,
                "title": "Valore vinto per segmento",
                "bind": {
                  "dim": "segmento",
                  "measure": "valore"
                }
              }
            ]
          }
        ]
      }
    }
