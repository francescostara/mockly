                    },
                    {
                      "measure": "gm",
                      "label": "Margine %",
                      "kind": "heat",
                      "scale": [
                        0.32,
                        0.6
                      ]
                    },
                    {
                      "measure": "prezzo",
                      "label": "Prezzo medio"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
    "drill": {
